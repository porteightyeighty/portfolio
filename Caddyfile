{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Astro writes /about/index.html; serve /about without a redirect.
	try_files {path} {path}/index.html
	file_server

	# Hashed build assets never change.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
